// Keep this order stable. The IDs are stored in BoostDeck settings.
SIGNAL(BOOST, "Boost", 0, 35, PRESSURE_PSI)
SIGNAL(AFR, "AFR", 9, 19, NUMBER)
SIGNAL(TIMING, "Timing", -20, 50, DEGREES)
SIGNAL(IAT, "Intake air", -20, 100, TEMPERATURE)
SIGNAL(TRANS, "Trans temp", 0, 150, TEMPERATURE)
SIGNAL(RAIL, "Rail pressure", 0, 250, PRESSURE_BAR)
SIGNAL(OIL, "Oil pressure", 0, 8, PRESSURE_BAR)
SIGNAL(COOLANT, "Coolant", 0, 130, TEMPERATURE)
#ifdef PERF_LAB
SIGNAL(ETHANOL, "Active ethanol", 0, 100, PERCENT)
SIGNAL(OIL_TEMP, "Oil temp", 40, 150, TEMPERATURE)
SIGNAL(BATTERY, "Voltage", 11, 15.5, VOLTS)
SIGNAL(RPM, "Engine RPM", 0, 8000, RPM)
SIGNAL(SPEED, "Speed", 0, 250, SPEED)
SIGNAL(LOAD, "Engine load", 0, 100, PERCENT)
SIGNAL(MAP, "Manifold abs.", 0, 255, PRESSURE_KPA)
SIGNAL(MAF, "Air flow", 0, 300, MASS_FLOW)
SIGNAL(THROTTLE, "Throttle", 0, 100, PERCENT)
SIGNAL(BARO, "Barometric", 60, 115, PRESSURE_KPA)
SIGNAL(AMBIENT, "Outside air", -20, 50, TEMPERATURE)
SIGNAL(FUEL_RATE, "Fuel rate", 0, 100, FUEL_FLOW)
SIGNAL(FUEL_LEVEL, "Fuel level", 0, 100, PERCENT)
SIGNAL(ACCELERATOR, "Accel. pedal", 0, 100, PERCENT)
SIGNAL(SPARK_ADVANCE, "Spark advance", -20, 50, DEGREES)
SIGNAL(ABS_LOAD, "Absolute load", 0, 250, PERCENT)
SIGNAL(STFT_B1, "STFT bank 1", -25, 25, PERCENT)
SIGNAL(LTFT_B1, "LTFT bank 1", -25, 25, PERCENT)
SIGNAL(STFT_B2, "STFT bank 2", -25, 25, PERCENT)
SIGNAL(LTFT_B2, "LTFT bank 2", -25, 25, PERCENT)
SIGNAL(LAMBDA_TARGET, "Lambda target", .7, 1.3, NUMBER)
SIGNAL(CAT_TEMP, "Catalyst temp", 0, 1100, TEMPERATURE)
SIGNAL(THROTTLE_TARGET, "Throttle target", 0, 100, PERCENT)
#endif
